# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# 大数据与结果不入库(见 XAI01-04_小组工作指导.md §7.2,大文件走网盘共享)
# 例外:data/ 下的标签表、元数据等小 CSV/JSON 需要版本管理,允许入库
data/*
!data/.gitkeep
!data/README.md
!data/*.csv
!data/*.json
!data/**/*.csv
!data/**/*.json
results/*
!results/.gitkeep
models/*.pt
models/*.pth

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 2080 Ti 试跑运行产物(脚本默认在 experiments/pilot-2080ti/ 下生成,不入库)
# 只入库:脚本、data_manifest.json、docs/pilot-2080ti/ 下的报告与聚合表
experiments/pilot-2080ti/*.jsonl
experiments/pilot-2080ti/*.log
experiments/pilot-2080ti/*.csv
experiments/pilot-2080ti/*_report.md
experiments/pilot-2080ti/*_summary.json
experiments/pilot-2080ti/environment_snapshot*.json
experiments/pilot-2080ti/weights_cache/
experiments/pilot-2080ti/vae_cache/
experiments/pilot-2080ti/mpl_cache/
experiments/pilot-2080ti/artifacts/
experiments/pilot-2080ti/__pycache__/
experiments/pilot-2080ti/data/
