!data/**/*.json
!data/voc20_multilabel_*.csv
!data/voc20_multilabel_*.txt
!data/VOC20_MULTILABEL_VERSION.json
results/*
!results/.gitkeep
analysis/out/
models/*.pt
models/*.pth
models/checkpoints/

